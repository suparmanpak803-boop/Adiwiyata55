# Salin ke .env.local dan isi. JANGAN commit .env.local.
# File ini hanya contoh — nilai asli tidak ada di repo.

# Database Postgres (Neon). Wajib.
DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Neon Auth (dashboard Neon > Auth). Wajib untuk login.
# Cookie secret minimal 32 karakter.
NEON_AUTH_BASE_URL=https://xxxx.neon-auth.com
NEON_AUTH_COOKIE_SECRET=isi-dengan-string-acak-minimal-32-karakter

# Kunci enkripsi token Apps Script (baru, lihat PERBAIKAN.md).
# 64 karakter hex (32 byte). Buat dengan: openssl rand -hex 32
# Token Sheets lama TIDAK bisa didekripsi dengan kunci ini — simpan
# ulang token sekali lewat panel Pengaturan Sheets.
SHEETS_TOKEN_KEY=

# Rahasia cron (dipakai Vercel Cron / scheduler eksternal untuk
# GET /api/cron/leaderboard-reset dengan header Authorization: Bearer <ini>).
CRON_SECRET=

# Vercel Blob (otomatis terisi bila proyek di-deploy di Vercel dan
# Blob Store ditautkan; untuk upload dokumen & foto laporan).
BLOB_READ_WRITE_TOKEN=
